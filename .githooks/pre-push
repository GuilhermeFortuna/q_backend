#!/usr/bin/env bash
set -euo pipefail

echo "==> Running pre-push hook (full CI pipeline)..."
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Git exports repository-local context to hooks. CI checks out other repositories,
# so let each nested Git command discover its own object database and worktree.
while IFS= read -r git_variable; do
  unset "$git_variable"
done < <(git rev-parse --local-env-vars)

# shellcheck source=.githooks/_common.sh
source "$REPO_ROOT/.githooks/_common.sh"
ensure_uv_on_path

push_revisions=()
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "${local_sha:-}" ]] || continue
    [[ "$local_sha" =~ ^0+$ ]] && continue

    already_seen=0
    for pushed_revision in "${push_revisions[@]}"; do
        if [[ "$pushed_revision" == "$local_sha" ]]; then
            already_seen=1
            break
        fi
    done
    if [[ "$already_seen" -eq 0 ]]; then
        push_revisions+=("$local_sha")
    fi
done

if [[ "${#push_revisions[@]}" -eq 0 ]]; then
    echo "==> No pushed revisions to validate."
    exit 0
fi

# The checkout and its virtual environment take several gigabytes. Keep them on disk:
# /tmp is often a RAM-backed tmpfs, where they count against the CI memory limit.
tmp_base="${Q_CI_TMPDIR:-/var/tmp}"
mkdir -p "$tmp_base"
tmp_root="$(mktemp -d "$tmp_base/q-backend-pre-push.XXXXXX")"
worktree="$tmp_root/checkout"

cleanup() {
    local status=$?
    trap - EXIT INT TERM
    if [[ -d "$worktree" ]]; then
        if ! git -C "$REPO_ROOT" worktree remove --force "$worktree"; then
            echo "ERROR: Could not remove temporary CI worktree: $worktree" >&2
            [[ "$status" -ne 0 ]] || status=1
        fi
    fi
    rm -rf "$tmp_root"
    exit "$status"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for pushed_revision in "${push_revisions[@]}"; do
    echo "==> Running CI for pushed revision ${pushed_revision}..."
    git -C "$REPO_ROOT" worktree add --quiet --detach "$worktree" "$pushed_revision"
    (
        cd "$worktree"
        export UV_PROJECT_ENVIRONMENT="$worktree/.venv"
        ./scripts/ci.sh
    )
    git -C "$REPO_ROOT" worktree remove --force "$worktree"
done
