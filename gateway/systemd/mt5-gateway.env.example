# Copy to ~/.config/mt5-gateway/mt5-gateway.env and edit. Consumed by both
# mt5-terminal.service and mt5-gateway.service.
#
# Absolute path to the q_backend checkout on the HOST filesystem (Linux path).
Q_BACKEND_DIR=/home/CHANGE_ME/q/q_backend

# Wine prefix created by setup_wine.sh (must match MT5_GATEWAY_PREFIX used there).
MT5_GATEWAY_PREFIX=/home/CHANGE_ME/.local/share/mt5-gateway-prefix
WINEPREFIX=/home/CHANGE_ME/.local/share/mt5-gateway-prefix

# Windows path to the Wine Python installed by setup_wine.sh.
MT5_WINE_PYTHON=C:\Python311\python.exe

# Gateway bind + auth (read directly by mt5_gateway.py via its env defaults).
# Keep 127.0.0.1 unless you have read the LAN/VPN + token caveat in the doc.
MT5_GATEWAY_HOST=127.0.0.1
MT5_GATEWAY_PORT=18812
# Leave empty for localhost-only. REQUIRED (non-empty) for any non-loopback bind.
MT5_GATEWAY_TOKEN=
