# Copy to ~/.config/mt5-edge/mt5-edge.env and edit. Shares the Wine prefix and
# Python install with the data gateway (setup_wine.sh).

Q_BACKEND_DIR=/home/CHANGE_ME/q/q_backend
MT5_GATEWAY_PREFIX=/home/CHANGE_ME/.local/share/mt5-gateway-prefix
WINEPREFIX=/home/CHANGE_ME/.local/share/mt5-gateway-prefix
MT5_WINE_PYTHON=C:\\Python311\\python.exe

# Loopback bind only (enforced by mt5_execution_edge.py).
MT5_EDGE_HOST=127.0.0.1
MT5_EDGE_PORT=18813
