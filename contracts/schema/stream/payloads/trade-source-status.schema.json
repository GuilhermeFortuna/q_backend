{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stream/payloads/trade-source-status",
  "title": "TradeSourceStatus",
  "description": "Latest-per-symbol coverage and source status. Its topic sequence is independent of trade delivery and cannot recover the tape.",
  "type": "object",
  "required": ["provider_id", "symbol", "source_generation", "volume_field", "volume_unit", "covered_from", "covered_to", "coverage_state", "coverage_reason", "classification_coverage", "last_trade_watermark"],
  "properties": {
    "provider_id": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}, "source_generation": {"type": "string", "minLength": 1},
    "volume_field": {"type": "string", "enum": ["volume", "volume_real"]}, "volume_unit": {"type": "string", "minLength": 1},
    "covered_from": {"type": ["string", "null"], "format": "date-time"}, "covered_to": {"type": ["string", "null"], "format": "date-time"},
    "coverage_state": {"type": "string", "enum": ["complete", "partial", "unavailable"]}, "classification_coverage": {"type": "string", "enum": ["complete", "partial", "unavailable"], "description": "Coverage of aggressor side classification, separate from range coverage."}, "coverage_reason": {"type": ["string", "null"]},
    "last_trade_watermark": {"$ref": "../replay/trade-watermark.schema.json"}
  },
  "additionalProperties": false
}
