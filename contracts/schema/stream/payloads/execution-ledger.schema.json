{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stream/payloads/execution-ledger",
  "title": "ExecutionLedgerEvent",
  "description": "Payload for ledger durable stream events carrying balance entry and post-entry account state.",
  "type": "object",
  "required": [
    "entity",
    "id",
    "account_id",
    "entry_type",
    "amount",
    "balance_after",
    "account_after",
    "updated_at"
  ],
  "properties": {
    "entity": {
      "const": "ledger_entry",
      "description": "Entity kind discriminator."
    },
    "id": {
      "$ref": "execution-common.schema.json#/$defs/UUID",
      "description": "Ledger entry identifier."
    },
    "account_id": {
      "$ref": "execution-common.schema.json#/$defs/UUID",
      "description": "Trading account identifier."
    },
    "paper_account_id": {
      "$ref": "execution-common.schema.json#/$defs/UUID",
      "description": "Paper account identifier alias."
    },
    "deployment_id": {
      "oneOf": [
        {
          "$ref": "execution-common.schema.json#/$defs/UUID"
        },
        {
          "type": "null"
        }
      ],
      "description": "Associated deployment identifier, or null for account-level transactions."
    },
    "fill_id": {
      "oneOf": [
        {
          "$ref": "execution-common.schema.json#/$defs/UUID"
        },
        {
          "type": "null"
        }
      ],
      "description": "Associated fill identifier if generated by trade execution."
    },
    "entry_type": {
      "$ref": "execution-common.schema.json#/$defs/LedgerEntryType"
    },
    "amount": {
      "$ref": "execution-common.schema.json#/$defs/Decimal",
      "description": "Monetary transaction amount in exact decimal string."
    },
    "balance_after": {
      "$ref": "execution-common.schema.json#/$defs/Decimal",
      "description": "Cash balance immediately following this entry."
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable description of transaction."
    },
    "account_after": {
      "$ref": "execution-common.schema.json#/$defs/ExecutionAccount",
      "description": "Trading account state immediately following this entry."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC creation timestamp."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC last update timestamp."
    }
  },
  "additionalProperties": false
}
