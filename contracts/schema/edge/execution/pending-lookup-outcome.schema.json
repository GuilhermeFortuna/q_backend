{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge/execution/pending-lookup-outcome",
  "title": "PendingLookupOutcome",
  "description": "Outcome of looking up a pending or protective intent (answer to a lookup request with kind pending). Each branch explicitly declares closes_intent: placed and unavailable leave the intent open, every other outcome is final.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "placed"
        },
        "order_ticket": {
          "type": "integer",
          "description": "Ticket of the pending order still resting at the broker."
        },
        "closes_intent": {
          "const": false
        }
      },
      "required": [
        "outcome",
        "order_ticket",
        "closes_intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "filled"
        },
        "deals": {
          "type": "array",
          "items": {
            "$ref": "deal.schema.json"
          },
          "description": "Deals that filled the pending order, in deal order."
        },
        "closes_intent": {
          "const": true
        }
      },
      "required": [
        "outcome",
        "deals",
        "closes_intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "cancelled"
        },
        "reason": {
          "type": "string",
          "description": "Optional cancellation reason text."
        },
        "closes_intent": {
          "const": true
        }
      },
      "required": [
        "outcome",
        "closes_intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "expired"
        },
        "closes_intent": {
          "const": true
        }
      },
      "required": [
        "outcome",
        "closes_intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "rejected"
        },
        "retcode": {
          "type": "integer",
          "description": "Terminal or broker rejection code."
        },
        "reason": {
          "type": "string",
          "description": "Optional rejection reason text."
        },
        "closes_intent": {
          "const": true
        }
      },
      "required": [
        "outcome",
        "retcode",
        "closes_intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "closes_intent": {
          "const": true
        }
      },
      "required": [
        "outcome",
        "closes_intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "description": "Explanation of query unavailability (MT5 disconnected, timeout, etc.)."
        },
        "closes_intent": {
          "const": false
        }
      },
      "required": [
        "outcome",
        "reason",
        "closes_intent"
      ],
      "additionalProperties": false
    }
  ]
}
