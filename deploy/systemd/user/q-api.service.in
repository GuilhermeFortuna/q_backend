[Unit]
Description=Q Backend API Service
PartOf=q-backend.target
StartLimitIntervalSec=0
Requires=q-postgres.service q-migrate.service
Wants=q-redis.service
After=q-postgres.service q-migrate.service q-redis.service

[Service]
Type=notify
EnvironmentFile=%h/.config/q/backend.env
WorkingDirectory=@Q_BACKEND_DIR@
ExecStart=@Q_BACKEND_DIR@/.venv/bin/q-api
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
RestartPreventExitStatus=78
TimeoutStartSec=90

[Install]
WantedBy=q-backend.target
