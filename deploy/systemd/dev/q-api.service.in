[Unit]
Description=Q Backend API Service (dev, Docker infra)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=%h/.config/q/backend.env
WorkingDirectory=@Q_BACKEND_DIR@
ExecStart=@Q_BACKEND_DIR@/.venv/bin/q-api
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
RestartPreventExitStatus=78
TimeoutStartSec=90

[Install]
WantedBy=default.target
