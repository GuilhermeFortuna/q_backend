[Unit]
Description=Q Execution Worker Service (dev, Docker infra)
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=%h/.config/q/backend.env
WorkingDirectory=@Q_BACKEND_DIR@
ExecStart=@Q_BACKEND_DIR@/.venv/bin/q-execution run
WatchdogSec=30
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
RestartPreventExitStatus=78 79
TimeoutStartSec=180

[Install]
WantedBy=default.target
