[Unit]
Description=Q Outbox Relay Service (dev, Docker infra)
After=network-online.target q-api.service
Wants=q-api.service

[Service]
Type=notify
EnvironmentFile=%h/.config/q/backend.env
WorkingDirectory=@Q_BACKEND_DIR@
ExecStart=@Q_BACKEND_DIR@/.venv/bin/q-outbox-relay
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
RestartPreventExitStatus=78
TimeoutStartSec=90

[Install]
WantedBy=default.target
