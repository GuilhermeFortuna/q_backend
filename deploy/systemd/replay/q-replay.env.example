# Environment of one replay run, written by ./dev replay (do not edit a running simulator).
# The launcher writes replay/backend.env separately; normal live/research environments and MT5 unit files stay untouched.
Q_REPLAY_STORE=/path/to/run/replay.sqlite3
Q_REPLAY_ROOT=/path/to/dataset
Q_REPLAY_MARKET_PORT=18912
Q_REPLAY_EDGE_PORT=18913
Q_REPLAY_ADMIN_PORT=18914
# Optional shared secret for the administrative listener (sent as X-Replay-Token).
# Q_REPLAY_TOKEN=
