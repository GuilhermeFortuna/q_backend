# Q Backend Environment Configuration
Q_DATABASE_URL=postgresql+psycopg://q:q@127.0.0.1:5434/q
Q_REDIS_URL=redis://127.0.0.1:6380/0

# Storage roots
Q_DATA_LAKE_ROOT=data/lake
Q_MARKET_DATA_ROOT=data/market
Q_TICK_CACHE_DIR=data/tick_cache
Q_RUNTIME_CONFIG_PATH=data/runtime_config.json

# Execution command idempotency (Q-050 default: require Idempotency-Key)
Q_EXECUTION_IDEMPOTENCY_ENFORCED=true

# Streaming & worker settings
Q_STREAM_SYMBOLS=WIN$,WDO$,PETR4,VALE3,ITUB4
Q_STREAM_BAR_TIMEFRAMES=M1,M5,M15,H1,D1
Q_WORKER_PROCESSES=14
