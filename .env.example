# MetaTrader 5
MT5_USER=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Storage infrastructure
Q_DATABASE_URL=postgresql+psycopg://q:q@localhost:5432/q
Q_REDIS_URL=redis://localhost:6380/0
Q_DATA_LAKE_ROOT=data/lake

# Background worker pool — the single CPU budget shared by all heavy jobs.
# Defaults to 14 (of 16 physical cores). The Dramatiq worker is launched with
# --processes $Q_WORKER_PROCESSES.
Q_WORKER_PROCESSES=14

# AI Strategy Builder (OpenAI-compatible local server, e.g. Ollama or LM Studio)
# Ollama local server: http://localhost:11434/v1 — run `ollama list` (or
# `curl http://localhost:11434/v1/models`) to discover model ids, and
# `ollama pull <id>` to download one. Q_AI_STRATEGY_MODEL is the dropdown's
# initial selection; Q_AI_STRATEGY_MODELS is the allowlist that fills the dropdown.
Q_AI_STRATEGY_ENABLED=true
Q_AI_STRATEGY_PROVIDER=openai_compatible
Q_AI_STRATEGY_BASE_URL=http://localhost:11434/v1
Q_AI_STRATEGY_MODEL=gemma4-e4b:latest
# "model_id|Label" pairs, comma-separated. The "|" separates id from label because
# Ollama ids embed a colon in their "name:tag" form (e.g. "gemma4-e4b:latest").
Q_AI_STRATEGY_MODELS=gemma4-e4b:latest|Gemma 4 E4B,gemma3:4b|Gemma 3 4B,qwen3.6:27b|Qwen 3.6 27B
Q_AI_STRATEGY_API_KEY=
Q_AI_STRATEGY_TIMEOUT_SECONDS=180
Q_AI_STRATEGY_MAX_OUTPUT_TOKENS=2048
# dev.sh auto-starts the Ollama server (if not already running) and pulls
# Q_AI_STRATEGY_MODEL on launch. Models load into memory lazily on first request.
