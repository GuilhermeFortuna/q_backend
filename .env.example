# MetaTrader 5
MT5_USER=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Storage infrastructure
Q_DATABASE_URL=postgresql+psycopg://q:q@localhost:5432/q
Q_REDIS_URL=redis://localhost:6380/0
Q_DATA_LAKE_ROOT=data/lake

# Background worker pool — the single CPU budget shared by all heavy jobs.
# Defaults to 14 (of 16 physical cores). The Dramatiq worker is launched with
# --processes $Q_WORKER_PROCESSES.
Q_WORKER_PROCESSES=14

# AI Strategy Builder (OpenAI-compatible local server, e.g. LM Studio or Ollama)
# LM Studio local server: http://localhost:1234/v1 — run `curl http://localhost:1234/v1/models`
# to discover model ids for Q_AI_STRATEGY_MODEL and Q_AI_STRATEGY_MODELS.
Q_AI_STRATEGY_ENABLED=true
Q_AI_STRATEGY_PROVIDER=openai_compatible
Q_AI_STRATEGY_BASE_URL=http://localhost:1234/v1
Q_AI_STRATEGY_MODEL=gemma-4-e4b-it
Q_AI_STRATEGY_MODELS=gemma-4-e4b-it:Gemma 4 E4B,qwythos-9b-claude-mythos-5-1m:Qwythos 9B
Q_AI_STRATEGY_API_KEY=
Q_AI_STRATEGY_TIMEOUT_SECONDS=120
Q_AI_STRATEGY_MAX_OUTPUT_TOKENS=4096
